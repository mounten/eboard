# cross-rs image: Ubuntu 20.04 (glibc 2.31) + GCC cross toolchain for one target arch.
#
# Linking against glibc 2.31 keeps the binaries runnable on JetPack 5, Raspberry Pi OS Bullseye and
# older Yocto BSPs. The upstream cross images are either too new (`main`: Ubuntu 24.04) or too old
# for current Rust build scripts (`0.2.5`: Ubuntu 16.04). No native libraries are needed: libgbm,
# libEGL and libGLESv2 are loaded at runtime.
#
# Build args (set per target in Cross.toml):
#   DEB_ARCH    Debian architecture (arm64, armhf, amd64)
#   GNU_TRIPLE  GCC triple (aarch64-linux-gnu, arm-linux-gnueabihf, x86_64-linux-gnu)
FROM ubuntu:20.04

ARG DEB_ARCH
ARG GNU_TRIPLE
ARG DEBIAN_FRONTEND=noninteractive

# amd64 builds natively. The other targets need the GCC cross toolchain and the target's glibc
# headers, which are amd64 packages on the default mirrors.
RUN set -eux; \
    if [ "${DEB_ARCH}" = amd64 ]; then \
      packages=""; \
    else \
      packages="gcc-${GNU_TRIPLE} libc6-dev-${DEB_ARCH}-cross"; \
    fi; \
    apt-get update; \
    apt-get install --assume-yes --no-install-recommends ca-certificates gcc libc6-dev ${packages}; \
    rm -rf /var/lib/apt/lists/*

# Only the variables of the target being built take effect.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc
ENV CC_armv7_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc
