# cross-rs image: Ubuntu 20.04 (glibc 2.31) + GCC cross toolchain + libgbm for one target arch.
#
# Linking against glibc 2.31 keeps the binaries runnable on JetPack 5, Raspberry Pi OS Bullseye and
# older Yocto BSPs. The upstream cross images are either too new (`main`: Ubuntu 24.04) or too old
# for current Rust build scripts (`0.2.5`: Ubuntu 16.04).
#
# Build args (set per target in Cross.toml):
#   DEB_ARCH    Debian architecture (arm64, armhf)
#   GNU_TRIPLE  GCC triple (aarch64-linux-gnu, arm-linux-gnueabihf)
FROM ubuntu:20.04

ARG DEB_ARCH
ARG GNU_TRIPLE
ARG DEBIAN_FRONTEND=noninteractive

# Foreign-arch packages live on ports.ubuntu.com; keep the default mirrors for amd64 only.
RUN sed -i 's/^deb /deb [arch=amd64] /' /etc/apt/sources.list \
 && for suite in focal focal-updates focal-security; do \
      echo "deb [arch=${DEB_ARCH}] http://ports.ubuntu.com/ubuntu-ports ${suite} main universe" \
        >> /etc/apt/sources.list; \
    done \
 && dpkg --add-architecture "${DEB_ARCH}" \
 && apt-get update \
 && apt-get install --assume-yes --no-install-recommends \
      ca-certificates \
      gcc \
      libc6-dev \
      pkg-config \
      "gcc-${GNU_TRIPLE}" \
      "libc6-dev-${DEB_ARCH}-cross" \
      "libgbm-dev:${DEB_ARCH}" \
 && rm -rf /var/lib/apt/lists/*

# Only the variables of the target being built take effect.
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc
ENV CC_armv7_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc
